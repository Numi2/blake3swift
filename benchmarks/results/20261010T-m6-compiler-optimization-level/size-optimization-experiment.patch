@@ -360,10 +360,15 @@ final class BLAKE3MetalPipelineCache: @unchecked Sendable {
 }
 
 private extension BLAKE3Metal.LibrarySource {
+    private static var usesSizeOptimizedRuntimeLibrary: Bool {
+        ProcessInfo.processInfo.environment["BLAKE3_SWIFT_METAL_OPTIMIZATION_LEVEL"]?
+            .lowercased() == "size"
+    }
+
     var cacheIdentifier: String {
         switch self {
         case .runtimeSource:
-            return "runtime-source"
+            return Self.usesSizeOptimizedRuntimeLibrary ? "runtime-source:size" : "runtime-source"
         case let .metallib(url):
             return "metallib:\(url.standardizedFileURL.path)"
         }
@@ -372,14 +377,26 @@ private extension BLAKE3Metal.LibrarySource {
     func makeLibrary(device: MTLDevice) throws -> MTLLibrary {
         switch self {
         case .runtimeSource:
-            return try device.makeLibrary(source: BLAKE3MetalKernelSource.chunkCVs, options: nil)
+            return try device.makeLibrary(
+                source: BLAKE3MetalKernelSource.chunkCVs,
+                options: Self.runtimeCompileOptions
+            )
         case let .metallib(url):
             return try device.makeLibrary(URL: url)
         }
     }
 
     func makeDigestLibrary(device: MTLDevice) throws -> MTLLibrary {
-        try device.makeLibrary(source: BLAKE3MetalKernelSource.digestOnlyHash, options: nil)
+        try device.makeLibrary(source: BLAKE3MetalKernelSource.digestOnlyHash, options: Self.runtimeCompileOptions)
+    }
+
+    private static var runtimeCompileOptions: MTLCompileOptions? {
+        guard usesSizeOptimizedRuntimeLibrary else {
+            return nil
+        }
+        let options = MTLCompileOptions()
+        options.optimizationLevel = .size
+        return options
     }
 }
 
